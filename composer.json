{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "proovit/laravel-url-watcher",
    "description": "Laravel 12 URL watcher package with event-driven detection, history, deduplication, classification, and notification hooks.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1.22"
    },
    "autoload": {
        "psr-4": {
            "Proovit\\UrlWatcher\\": "src/",
            "Proovit\\UrlWatcher\\Database\\Factories\\": "database/factories/",
            "Proovit\\UrlWatcher\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Proovit\\UrlWatcher\\UrlWatcherServiceProvider"
            ]
        }
    },
    "scripts": {
        "format": [
            "@php vendor/bin/pint src tests"
        ],
        "format:test": [
            "@php vendor/bin/pint --test src tests"
        ],
        "analyse": [
            "@php vendor/bin/phpstan analyse src tests --ansi --memory-limit=1G"
        ],
        "qa": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": [
            "@php vendor/bin/pest"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
